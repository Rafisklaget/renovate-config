{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboardLabels": ["dependency-dashboard"],
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":automergeDigest",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Oslo",
  "minimumReleaseAge": "96 hours",
  "osvVulnerabilityAlerts": true,
  "docker": {
    "pinDigests": true,
    "digest": {
      "automerge": true
    }
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on the first day of the month"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["pinDigest"],
      "automerge": true,
      "description": "Automerge immutable digest pins for actions and container images"
    },
    {
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "description": "Automerge stable SemVer patch updates"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "groupName": "npm patch dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor"],
      "groupName": "npm minor dependencies"
    }
  ]
}
